{
  "name": "audit-unencrypted-managed-disks",
  "displayName": "Audit Managed Disks without Encryption at Host",
  "description": "Audits virtual machines that do not have encryption at host enabled.",
  "mode": "Indexed",
  "category": "Security Baseline",
  "parameters": {
    "effect": {
      "type": "String",
      "metadata": {
        "displayName": "Effect",
        "description": "Audit, Deny, or Disabled"
      },
      "allowedValues": ["Audit", "Deny", "Disabled"],
      "defaultValue": "Audit"
    }
  },
  "policyRule": {
    "if": {
      "allOf": [
        {
          "field": "type",
          "equals": "Microsoft.Compute/virtualMachines"
        },
        {
          "field": "Microsoft.Compute/virtualMachines/securityProfile.encryptionAtHost",
          "notEquals": "true"
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  }
}
